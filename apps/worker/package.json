{
  "name": "@ondes/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/main.ts",
    "start": "node src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "loudness:backfill": "node --env-file-if-exists=../../.env src/jobs/loudness/backfill.ts",
    "autocue:backfill": "node --env-file-if-exists=../../.env src/jobs/autocue/backfill.ts",
    "peaks:backfill": "node --env-file-if-exists=../../.env src/jobs/peaks/backfill.ts"
  },
  "dependencies": {
    "@ondes/db": "workspace:*",
    "@ondes/queue": "workspace:*",
    "@ondes/shared": "workspace:*",
    "@ondes/storage": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "waveform-data": "4.5.2"
  }
}
