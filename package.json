{
  "name": "ondes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive --parallel --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:engine": "sh engine/tests/run.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
