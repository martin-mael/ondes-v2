{
  "name": "ondes",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.18"
  },
  "scripts": {
    "dev": "pnpm --recursive --parallel --if-present run dev",
    "dev:up": "docker compose -f deploy/compose.dev.yml up -d --wait postgres rabbitmq garage icecast liquidsoap mailpit && docker compose -f deploy/compose.dev.yml run --rm garage-init",
    "dev:down": "docker compose -f deploy/compose.dev.yml down",
    "dev:reset": "docker compose -f deploy/compose.dev.yml down -v",
    "dev:logs": "docker compose -f deploy/compose.dev.yml logs -f",
    "dev:ps": "docker compose -f deploy/compose.dev.yml ps -a",
    "dev:seed": "node --env-file-if-exists=.env deploy/dev/seed/index.ts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm --recursive --parallel --if-present run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:engine": "sh engine/tests/run.sh",
    "test:engine:template": "pnpm exec tsc -p engine/tests/template && node engine/tests/template/run.ts",
    "test:engine:splice": "sh engine/tests/splice/run.sh"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
