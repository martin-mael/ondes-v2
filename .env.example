# Local development environment. Copy to `.env` (git-ignored) and adjust if needed.
# Defaults match deploy/compose.dev.yml; see deploy/README.md for every service.
# Never put real secrets in this file.

# --- Postgres -------------------------------------------------------------------
POSTGRES_USER=ondes
POSTGRES_PASSWORD=ondes
POSTGRES_DB=ondes
POSTGRES_TEST_DB=ondes_test
POSTGRES_PORT=5432
DATABASE_URL=postgres://ondes:ondes@127.0.0.1:5432/ondes
TEST_DATABASE_URL=postgres://ondes:ondes@127.0.0.1:5432/ondes_test

# --- RabbitMQ -------------------------------------------------------------------
RABBITMQ_USER=ondes
RABBITMQ_PASSWORD=ondes
RABBITMQ_VHOST=ondes
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://ondes:ondes@127.0.0.1:5672/ondes

# --- S3 (Garage) ----------------------------------------------------------------
# Garage keys must look like GK + 24 hex chars, secrets 64 hex chars.
S3_ENDPOINT=http://127.0.0.1:3900
S3_PORT=3900
S3_REGION=garage
S3_BUCKET=ondes-dev
S3_ACCESS_KEY_ID=GK6f6e6465732d6465762d6b65
S3_SECRET_ACCESS_KEY=fc0e6e6f0bb08c084598a6494af6fc8299054cfbcb7e11d28c2241aeb3b54ee8
S3_FORCE_PATH_STYLE=true
GARAGE_ADMIN_PORT=3903
GARAGE_ADMIN_TOKEN=ondes-dev-admin-token
GARAGE_RPC_SECRET=0c0e909319f61fcdb55ae72965e15321a109fe535601cad945461f8ecf8f1680

# --- Icecast --------------------------------------------------------------------
ICECAST_URL=http://127.0.0.1:8000
ICECAST_PORT=8000
ICECAST_SOURCE_PASSWORD=ondes-dev-source
ICECAST_RELAY_PASSWORD=ondes-dev-relay
ICECAST_ADMIN_USER=admin
ICECAST_ADMIN_PASSWORD=ondes-dev-admin
# Api only (#32). The listener stats poller runs when ICECAST_URL and ICECAST_ADMIN_PASSWORD
# are set. The config sync runs when ICECAST_CONFIG_PATH is set: unset in dev, where Icecast
# keeps the static deploy/dev/icecast/icecast.xml. See deploy/icecast/README.md.
# ICECAST_CONFIG_PATH=/srv/ondes/icecast/icecast.xml
# ICECAST_SOURCE_SECRET=   # ≥ 16 chars; derives station passwords when the engine lifecycle is absent
# ICECAST_ASSETS_DIR=/srv/ondes/stream-assets
# ICECAST_PUBLIC_HOSTNAME=stream.example.org
# ICECAST_STATS_INTERVAL_MS=15000
# ICECAST_SYNC_INTERVAL_MS=30000

# --- Api ------------------------------------------------------------------------
API_PORT=3000
# Base URL of the web app, used in email links.
APP_URL=http://localhost:5173
# 32+ random characters (`openssl rand -base64 32`). Encrypts TOTP secrets: keep it stable.
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Plain-http local development only: browsers drop Secure cookies on http://localhost otherwise.
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_DAYS=30
# Requests per minute, per client IP, on each auth route (login, sign-up, reset, ...).
AUTH_RATE_LIMIT_MAX=10
# Which proxies may set X-Forwarded-For (rate limits key on the client IP). Unset: loopback and
# private networks (Caddy on the Docker network). `false` to disable, `true` or a CIDR list to override.
API_TRUST_PROXY=

# --- Email (Mailpit in dev) -----------------------------------------------------
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Ondes <no-reply@localhost>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Station engines (#35) --------------------------------------------------------
# Unset ENGINE_DOCKER_URL: the api manages no engine containers (the default in dev).
# See apps/api/src/modules/engine/lifecycle/README.md for every ENGINE_* variable.
# ENGINE_DOCKER_URL=http://docker-proxy-guard:2375
# ENGINE_NETWORK=ondes_engines
# ENGINE_API_URL=http://api:3000
# ENGINE_CACHE_ROOT=/srv/ondes/cache
# Host DJs type into BUTT/Mixxx/OBS (#63). Default: APP_URL's host.
# LIVE_PUBLIC_HOST=live.example.org

# --- Playout cache (#31) ----------------------------------------------------------
# Where the worker keeps the station caches (read-write; each engine mounts
# <ENGINE_CACHE_ROOT>/<stationId> read-only). Defaults to ENGINE_CACHE_ROOT. Unset: the worker
# keeps no cache. See apps/worker/src/jobs/cache-sync/README.md.
# PLAYOUT_CACHE_ROOT=/srv/ondes/cache
# CACHE_BUDGET_GB=40
# CACHE_HORIZON_HOURS=48
# CACHE_CONCURRENCY=4
# CACHE_WORKER_DOWNLOADS=8
# 32+ random characters (`openssl rand -base64 32`). Seals the engines' secrets: keep it stable.
# ENGINE_SECRETS_KEY=dev-only-engine-secrets-key-change-me-0123
